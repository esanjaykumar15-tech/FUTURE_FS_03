# ===== Server (server/.env) — NEVER commit real values =====
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-only. Never expose in browser code or VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Business details (placeholders until verified with the owner)
BUSINESS_NAME=BrewSpace Café (Demo)
BUSINESS_PHONE=+000-000-0000
BUSINESS_ADDRESS=123 Sample Street, Sample City
BUSINESS_WHATSAPP_NUMBER=0000000000

# ===== Client (client/.env) — only public values =====
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
