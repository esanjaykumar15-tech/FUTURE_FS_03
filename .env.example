# =====================================================================
# BrewSpace Café — environment variables (PLACEHOLDERS ONLY).
# Copy the SERVER block to server/.env and the CLIENT block to client/.env.
# Never commit real values. Never put the service-role key in a VITE_ variable.
# =====================================================================

# ---------- SERVER (server/.env, or Render dashboard) ----------
PORT=4000
NODE_ENV=development
# Allowed browser origin(s): exact scheme+host, NO trailing slash, comma-separated.
# Production example: https://your-site.vercel.app,https://www.yourcafe.com
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret. Server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BUSINESS_NAME=BrewSpace Café (Demo)

# ---------- CLIENT (client/.env, or Vercel dashboard; read at BUILD time) ----------
# Must include /api and must be HTTPS in production.
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public anon key (safe in the browser; protected by RLS).
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Business details shown on the public site (all optional; sample defaults apply)
VITE_BUSINESS_NAME=BrewSpace Café
# Set to "false" ONLY after the owner has verified every detail and photo.
VITE_SAMPLE_CONTENT=true
VITE_BUSINESS_PHONE=+000 000 0000
# Digits only, with country code, e.g. 15550100000
VITE_BUSINESS_WHATSAPP=0000000000
VITE_BUSINESS_EMAIL=hello@example.com
VITE_BUSINESS_ADDRESS=123 Sample Street, Sample City
VITE_CURRENCY=USD
VITE_LOCALE=en-US
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
